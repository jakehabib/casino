# ── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin used for CSRF origin checks and links
APP_URL=http://localhost:3000

# ── Data stores ──────────────────────────────────────
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova?schema=public&connection_limit=20
# Used by integration tests (wiped between runs)
TEST_DATABASE_URL=postgresql://nova:nova@localhost:5432/nova_test?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6379

# ── Security ─────────────────────────────────────────
# 32+ random bytes. Used to sign non-session tokens. `openssl rand -hex 32`
AUTH_SECRET=change-me-to-a-long-random-string
# Session lifetime in days
SESSION_TTL_DAYS=30

# ── Development tools ────────────────────────────────
# Dev panel + forced outcomes. Hard-disabled whenever NODE_ENV=production.
ENABLE_DEV_TOOLS=true

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=info
